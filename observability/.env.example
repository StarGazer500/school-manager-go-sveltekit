# Copied to .env on the first `make up` (with a random password). .env is
# not committed: it holds secrets and per-machine settings.

# Grafana login: user "admin" with this password.
GRAFANA_ADMIN_PASSWORD=change-me

# Of the traces that are neither errors nor slow (> 500 ms), the share to
# keep. Errors and slow traces are always kept. 100 keeps everything.
TRACE_SAMPLING_PERCENT=25
